{
  "name": "lagu-full-album",
  "version": "0.0.0-foundation",
  "private": true,
  "description": "Lagu Full Album Windows desktop app — STEP 11 feature waves in progress.",
  "main": "dist/main/bootstrap.cjs",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "dev": "npm run build && electron dist/main/bootstrap.cjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" package.json \"tsconfig*.json\" vite.config.ts eslint.config.js electron-builder.yml index.html resources/tools/manifest.json",
    "format:check": "prettier --write tests/component/AppShell.visual-layer-editor.test.tsx && git --no-pager diff -- tests/component/AppShell.visual-layer-editor.test.tsx && node -e \"process.exit(1)\"",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "arch:check": "node scripts/verify-architecture.mjs",
    "verify:secrets": "node scripts/verify-no-secrets.mjs",
    "verify:paths": "node scripts/verify-portable-paths.mjs",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:component": "vitest run tests/component --environment jsdom",
    "build:main": "esbuild src/main/bootstrap.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=dist/main/bootstrap.cjs",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=dist/preload/index.cjs",
    "build:renderer": "vite build",
    "build:render": "esbuild src/render/entry.ts --bundle --platform=browser --format=esm --target=es2022 --outfile=dist/render/entry.js",
    "build": "npm run clean && npm run build:main && npm run build:preload && npm run build:renderer && npm run build:render",
    "package:windows": "npm run build && electron-builder --win dir --x64 --publish never",
    "smoke:packaged:windows": "node scripts/smoke-packaged-windows.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run arch:check && npm run verify:secrets && npm run verify:paths && npm run verify:ui-reference && npm run test:unit && npm run test:contract && npm run test:component && npm run test:integration && npm run build",
    "verify:ui-reference": "node scripts/verify-ui-reference-pack.mjs",
    "ui:screenshot:scr002a": "electron dist/main/bootstrap.cjs --ui-test=SCR-002A --screenshot=artifacts/ui/SCR-002A.png",
    "test:integration": "vitest run tests/integration",
    "e2e:slc:save-reopen": "node scripts/run-slc-save-reopen.mjs",
    "e2e:w11:lifecycle": "node scripts/run-w11-project-lifecycle.mjs",
    "e2e:w11:recovery": "node scripts/run-w11-recovery.mjs",
    "e2e:w11:media-closure": "node scripts/run-w11-media-intake-closure.mjs",
    "e2e:w11:timeline-history-closure": "node scripts/run-w11-album-timeline-history-closure.mjs",
    "e2e:w11:auto-binding-closure": "node scripts/run-w11-auto-binding-closure.mjs",
    "e2e:w11:visual-template-closure": "node scripts/run-w11-visual-template-closure.mjs"
  },
  "dependencies": {
    "music-metadata": "12.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "43.6.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
